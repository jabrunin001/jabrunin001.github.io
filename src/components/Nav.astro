---
import { profile } from "../data/content";
const links = [
  { href: "#work", label: "What I build" },
  { href: "#projects", label: "Projects" },
  { href: "#experience", label: "Experience" },
];
---
<header class="nav">
  <div class="container nav-inner">
    <a href="#top" class="brand">{profile.name}</a>
    <nav aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a href="#contact" class="btn btn-primary nav-cta">Get in touch</a>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,.72); backdrop-filter: blur(12px) saturate(160%);
    border-bottom: 1px solid transparent;
    transition: border-color .3s var(--ease), box-shadow .3s var(--ease), background .3s var(--ease); }
  .nav.scrolled { border-bottom-color: var(--border);
    background: rgba(255,255,255,.85); box-shadow: 0 4px 20px rgba(15,58,58,.06); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between;
    height: 76px; gap: 1rem; transition: height .3s var(--ease); }
  .nav.scrolled .nav-inner { height: 62px; }
  .brand { color: var(--navy); font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; flex-shrink: 0; }
  .brand:hover { color: var(--accent-hover); }
  nav { display: flex; gap: 1.8rem; }
  nav a { position: relative; color: var(--slate); font-size: .95rem; font-weight: 500; padding: .2rem 0; }
  nav a::after { content: ""; position: absolute; left: 0; bottom: -2px; height: 2px; width: 100%;
    background: var(--accent); border-radius: 2px; transform: scaleX(0); transform-origin: left;
    transition: transform .3s var(--ease); }
  nav a:hover { color: var(--navy); }
  nav a:hover::after, nav a[data-active]::after { transform: scaleX(1); }
  nav a[data-active] { color: var(--navy); }
  .nav-cta { padding: .5rem 1.1rem; font-size: .9rem; }
  @media (max-width: 760px) { nav { display: none; } }
  @media (max-width: 420px) { .brand { font-size: .95rem; } .nav-cta { padding: .45rem .8rem; } }
</style>
