---
import { stats } from "../data/content";
---
<section class="stats">
  <div class="stats-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="grid">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`--rd:${i * 110}ms`}>
          <div class="val tnum" data-countup={s.value}>{s.value}</div>
          <div class="lbl">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats { position: relative; background: var(--teal-deep); overflow: hidden; }
  .stats-glow { position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(40% 80% at 18% 20%, rgba(20,184,166,.28), transparent 60%),
      radial-gradient(40% 80% at 85% 90%, rgba(45,212,191,.20), transparent 60%); }
  .grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .stat .val { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -0.02em;
    background: linear-gradient(120deg, #99f6e4, #2dd4bf); -webkit-background-clip: text;
    background-clip: text; -webkit-text-fill-color: transparent; color: #2dd4bf; }
  .lbl { color: #a7cfca; font-size: .92rem; margin-top: .5rem; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; } }
</style>
