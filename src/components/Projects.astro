---
import { projects } from "../data/content";
import Icon from "./Icon.astro";

// Abstract line-art motifs drawn on each card's gradient header.
const motifs: Record<string, string> = {
  stream: `
    <path d="M8 30 H232" opacity=".22"/><path d="M8 52 H232" opacity=".22"/><path d="M8 74 H232" opacity=".22"/>
    <circle class="pkt" style="animation-delay:0s" cx="20" cy="30" r="5" fill="currentColor" stroke="none"/>
    <circle class="pkt" style="animation-delay:-1s" cx="20" cy="52" r="5" fill="currentColor" stroke="none"/>
    <circle class="pkt" style="animation-delay:-2s" cx="20" cy="74" r="5" fill="currentColor" stroke="none"/>`,
  layers: `
    <path d="M78 26 l60 0 l40 16 l-60 0 z" fill="currentColor" stroke="none" opacity=".30"/>
    <path d="M66 46 l60 0 l40 16 l-60 0 z" fill="currentColor" stroke="none" opacity=".52"/>
    <path d="M54 66 l60 0 l40 16 l-60 0 z" fill="currentColor" stroke="none" opacity=".80"/>`,
  shield: `
    <path d="M120 16 l34 12 v18 c0 22 -16 33 -34 40 c-18 -7 -34 -18 -34 -40 v-18 z" stroke-width="3" opacity=".5"/>
    <path d="M104 52 l11 11 l24 -26" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  pipeline: `
    <path d="M62 50 H106 M134 50 H178" stroke-width="2.5" opacity=".4"/>
    <circle cx="50" cy="50" r="11" stroke-width="2.5" opacity=".7"/>
    <circle cx="120" cy="50" r="11" stroke-width="2.5" opacity=".7"/>
    <circle cx="190" cy="50" r="11" stroke-width="2.5" opacity=".7"/>
    <path d="M101 44 l7 6 l-7 6 M173 44 l7 6 l-7 6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity=".7"/>`,
  chart: `
    <rect x="50" y="58" width="18" height="24" rx="2" fill="currentColor" stroke="none" opacity=".38"/>
    <rect x="86" y="46" width="18" height="36" rx="2" fill="currentColor" stroke="none" opacity=".55"/>
    <rect x="122" y="34" width="18" height="48" rx="2" fill="currentColor" stroke="none" opacity=".72"/>
    <rect x="158" y="24" width="18" height="58" rx="2" fill="currentColor" stroke="none" opacity=".9"/>
    <path d="M50 54 L95 42 L131 32 L167 22" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>`,
  console: `
    <rect x="44" y="24" width="152" height="56" rx="4" opacity=".42"/>
    <path d="M58 42 h32 M58 58 h50 M58 68 h28" stroke-width="2.5" opacity=".82"/>
    <path d="M130 58 l12 -18 l12 26 l12 -16 l16 0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>`,
  ledger: `
    <path d="M64 22 h112 v60 H64 z" opacity=".38"/>
    <path d="M88 22 v60 M64 42 h112 M64 62 h112" stroke-width="2.5" opacity=".62"/>
    <path d="M102 52 h28 M102 72 h20 M146 52 h16 M146 72 h16" stroke-width="3" stroke-linecap="round"/>`,
  parity: `
    <path d="M18 80 H222" opacity=".18"/>
    <path d="M22 58 C 84 56, 150 44, 218 22 L218 52 C 150 54, 84 56, 22 58 Z" fill="currentColor" stroke="none" opacity=".14"/>
    <path d="M22 58 C 78 56, 140 54, 218 52" stroke-width="3" opacity=".5"/>
    <path d="M22 58 C 84 56, 150 44, 218 22" stroke-width="3.5"/>
    <circle cx="22" cy="58" r="4" fill="currentColor" stroke="none" opacity=".85"/>
    <circle cx="218" cy="52" r="4.5" fill="currentColor" stroke="none" opacity=".5"/>
    <circle cx="218" cy="22" r="5" fill="currentColor" stroke="none"/>`,
  chain: `
    <path d="M8 50 H66 M174 50 H232" opacity=".22"/>
    <rect x="70" y="35" width="60" height="30" rx="15" stroke-width="3" opacity=".5"/>
    <rect x="110" y="35" width="60" height="30" rx="15" stroke-width="3.5"/>
    <circle cx="20" cy="50" r="4.5" fill="currentColor" stroke="none" opacity=".8"/>
    <circle cx="220" cy="50" r="4.5" fill="currentColor" stroke="none" opacity=".5"/>`,
};

const counts = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"];
const countWord = counts[projects.length] ?? String(projects.length);
---
<section id="projects" class="alt">
  <div class="container">
    <div class="reveal">
      <p class="eyebrow">Projects</p>
      <h2 class="section-title">{countWord} builds across the data stack.</h2>
    </div>
    <div class="grid">
      {projects.map((p, i) => (
        <article class="card card-hover proj reveal" style={`--rd:${i * 80}ms`}>
          <div class="thumb" data-motif={p.motif}>
            <svg class="motif" viewBox="0 0 240 100" fill="none" stroke="currentColor"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={motifs[p.motif] ?? ""}></svg>
            <span class="thumb-name mono">{p.name}</span>
          </div>
          <div class="proj-in">
            <p class="tagline">{p.tagline}</p>
            <p class="blurb">{p.blurb}</p>
            <div class="badges">{p.stack.map((s) => <span>{s}</span>)}</div>
            <div class="links">
              {p.links.map((l, j) => (
                <a class:list={["plink", { primary: j === 0 }]} href={l.url} target="_blank" rel="noopener">
                  <Icon name={l.icon} size={15} /> {l.label}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .alt { background: var(--bg-alt); }
  .section-title { margin: .4rem 0 3rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; align-items: stretch; }
  .proj { display: flex; flex-direction: column; overflow: hidden; }
  .proj-in { position: relative; z-index: 1; display: flex; flex-direction: column; padding: 1.5rem; flex: 1; }

  /* gradient header with motif */
  .thumb { position: relative; height: 128px; overflow: hidden; display: flex; align-items: flex-end;
    background: linear-gradient(135deg, #0d9488, #0ea5b7); }
  .thumb[data-motif="layers"]   { background: linear-gradient(135deg, #0f766e, #0d9488); }
  .thumb[data-motif="shield"]   { background: linear-gradient(135deg, #0d9488, #10b981); }
  .thumb[data-motif="console"]  { background: linear-gradient(135deg, #0f766e, #2563eb); }
  .thumb[data-motif="ledger"]   { background: linear-gradient(135deg, #0c302f, #0d9488); }
  .thumb[data-motif="pipeline"] { background: linear-gradient(135deg, #0e7490, #0d9488); }
  .thumb[data-motif="chart"]    { background: linear-gradient(135deg, #0f766e, #14b8a6); }
  .thumb[data-motif="parity"]   { background: linear-gradient(135deg, #0f766e, #16a34a); }
  .thumb[data-motif="chain"]    { background: linear-gradient(135deg, #115e59, #0891b2); }
  .thumb::after { content: ""; position: absolute; inset: 0;
    background: radial-gradient(120% 80% at 80% 0%, rgba(255,255,255,.18), transparent 55%); }
  .motif { position: absolute; inset: 0; width: 100%; height: 100%; color: #fff; opacity: .85;
    transition: transform .5s var(--ease), opacity .3s var(--ease); }
  .proj.card-hover:hover .motif { transform: scale(1.06); opacity: 1; }
  .thumb-name { position: relative; z-index: 1; color: #fff; font-family: var(--font-mono);
    font-size: .92rem; font-weight: 600; padding: .8rem 1rem; letter-spacing: -.01em;
    text-shadow: 0 1px 6px rgba(8,40,38,.45); }
  .pkt { transform-box: fill-box; transform-origin: center; animation: pktmove 3.2s linear infinite; }
  @keyframes pktmove {
    0% { transform: translateX(0); opacity: 0; }
    12% { opacity: 1; } 88% { opacity: 1; }
    100% { transform: translateX(208px); opacity: 0; }
  }

  .tagline { color: var(--accent-ink); font-weight: 600; font-size: .82rem; letter-spacing: .02em; }
  .blurb { color: var(--slate); font-size: .94rem; margin-top: .5rem; flex: 1; }
  .badges { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1.1rem; }
  .badges span { font-size: .72rem; font-weight: 600; padding: .25rem .6rem; border-radius: 999px;
    background: #fff; border: 1px solid var(--border-strong); color: var(--muted);
    transition: color .2s var(--ease), border-color .2s var(--ease); }
  .proj.card-hover:hover .badges span { color: var(--accent-ink); border-color: var(--accent); }

  .links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.3rem; padding-top: 1.2rem; border-top: 1px solid var(--border); }
  .plink { display: inline-flex; align-items: center; gap: .4rem; font-size: .82rem; font-weight: 600;
    padding: .42rem .8rem; border-radius: 999px; border: 1px solid var(--border-strong); color: var(--accent-ink);
    transition: background .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease), transform .15s var(--ease); }
  .plink:hover { border-color: var(--accent); background: var(--accent-soft); transform: translateY(-1px); }
  .plink.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .plink.primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .pkt { animation: none; opacity: 1; }
    .motif { transition: none; }
  }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; gap: 1.2rem; } }
</style>
